# OreGenesis-Agent — language-model backend configuration
# Copy this file to `.env` in the project root and fill in your values.
# Priority: process environment variable > this file > built-in default.
# Never commit the real .env (it contains your API key).

# --- Required: any OpenAI-compatible endpoint ---------------------------
# Cloud examples:  https://api.deepseek.com   /  https://open.bigmodel.cn/api/paas/v4
# Local examples:  http://127.0.0.1:11434 (Ollama)  /  http://127.0.0.1:8000/v1 (vLLM, llama-server)
LLM_API_BASE=http://127.0.0.1:11434
LLM_API_KEY=ollama          # any non-empty string is accepted by local servers
LLM_MODEL_NAME=qwen3.6:27b  # model tag as served by the endpoint

# --- Optional tuning ----------------------------------------------------
#LLM_MIN_INTERVAL=2.0      # minimum seconds between requests (cloud rate-limit protection; local: 0)
#LLM_MAX_RETRIES=6         # exponential-backoff retries on 429/5xx/network errors
#LLM_NUM_CTX=32768         # context window (tokens) for local Ollama models
#LLM_DISABLE_THINKING=1    # 1 (default) = request direct answers from reasoning models; 0 = keep thinking segments
